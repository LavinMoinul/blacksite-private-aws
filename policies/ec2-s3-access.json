{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAuthorizedPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::blacksite-data-lavin-714415",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "allowed",
            "allowed/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadWriteAuthorizedPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::blacksite-data-lavin-714415/allowed/*"
    }
  ]
}

